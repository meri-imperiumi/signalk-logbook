{
  "env": {
    "browser": true
  },
  "extends": [
    "airbnb-base",
    "plugin:react/recommended"
  ],
  "plugins": [
    "react"
  ],
  "parserOptions": {
    "ecmaFeatures": {
      "jsx": true
    },
    // airbnb-base 15 pins 2018; the plotterext pages and their tests
    // speak modern ESM (dynamic import, top-level await)
    "ecmaVersion": 2022
  },
  "overrides": [
    {
      // Node ESM dynamic import needs the explicit extension; the
      // airbnb import/extensions default is for bundler resolution
      "files": ["test/plotterext.test.js"],
      "rules": {
        "import/extensions": "off"
      }
    }
  ],
  "rules": {
    "import/no-extraneous-dependencies": [
      "error",
      {
        "devDependencies": [
          "webpack.config.js",
          "src/*.jsx",
          "src/components/*.jsx"
        ],
        "optionalDependencies": false
      }
    ],
    "react/prop-types": "warn",
    "linebreak-style": "warn",
    "no-underscore-dangle": "warn"
  }
}
